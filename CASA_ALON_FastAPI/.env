# ---------- Conversation memory ----------
# Leave empty for testing (resets on restart). Set to a file name to keep history.
MEMORY_DB_PATH=

# ---------- Server security ----------
# Protects /ask and /refresh (n8n sends this as the X-API-Key header)
INTERNAL_API_KEY=make-up-a-long-random-string #NO N8N For Now

# ---------- Staff handoff (optional) ----------
# n8n Webhook node URL. Receives an alert when the bot hands off to staff.
STAFF_WEBHOOK_URL=

# ---------- Meta (shared by Facebook and WhatsApp) ----------
